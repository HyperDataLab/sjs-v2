FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ARG VITE_API_BASE_URL
ARG VITE_ORIGIN_URL
ARG VITE_PAGE_BASE_URL
ARG VITE_PARENT_ORIGIN
ARG VITE_EMBED_ALLOWED_ORIGINS
ARG VITE_WORKER_API_URL
ARG VITE_FIREBASE_API_KEY
ARG VITE_HYPERDATALAB_SSO_BASE_URL
ARG VITE_HYPERDATALAB_SSO_CLIENT_ID
ARG VITE_HYPERDATALAB_SSO_CALLBACK_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ORIGIN_URL=$VITE_ORIGIN_URL
ENV VITE_PAGE_BASE_URL=$VITE_PAGE_BASE_URL
ENV VITE_PARENT_ORIGIN=$VITE_PARENT_ORIGIN
ENV VITE_EMBED_ALLOWED_ORIGINS=$VITE_EMBED_ALLOWED_ORIGINS
ENV VITE_WORKER_API_URL=$VITE_WORKER_API_URL
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_HYPERDATALAB_SSO_BASE_URL=$VITE_HYPERDATALAB_SSO_BASE_URL
ENV VITE_HYPERDATALAB_SSO_CLIENT_ID=$VITE_HYPERDATALAB_SSO_CLIENT_ID
ENV VITE_HYPERDATALAB_SSO_CALLBACK_URL=$VITE_HYPERDATALAB_SSO_CALLBACK_URL

RUN npm run build


FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
