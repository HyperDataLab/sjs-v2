# Firebase Web API key used when exchanging the Worker custom token for a Firebase session.
VITE_FIREBASE_API_KEY=

# Worker API. Keep localhost for local Worker development; use the deployed URL for production.
VITE_WORKER_API_URL=http://127.0.0.1:43877
# Production example: https://scientificjournalsystem-api.phunghao2701.workers.dev

# HyperDataLab OAuth Authorization Code + PKCE public client.
# Register this exact callback URL with the SSO provider.
VITE_HYPERDATALAB_SSO_BASE_URL=
VITE_HYPERDATALAB_SSO_CLIENT_ID=
VITE_HYPERDATALAB_SSO_CALLBACK_URL=http://localhost:5173/auth/sso/callback

# Optional local development shortcuts (only rendered in Vite development mode).
VITE_DEV_USER_EMAIL=
VITE_DEV_USER_PASSWORD=
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=

# Optional integrations; set only when the corresponding service is used.
VITE_ORIGIN_URL=http://localhost:5174
VITE_PAGE_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:43877/api/v1
VITE_PARENT_ORIGIN=http://localhost:5173
VITE_EMBED_ALLOWED_ORIGINS=http://localhost:5173
